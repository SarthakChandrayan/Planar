# Copy to .env (project root or backend/) and adjust. All values are optional.

# --- Model -------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Must be installed: `ollama list`. qwen3:4b suits a 16 GB laptop on CPU.
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=false
# Context window in tokens. Bigger uses more RAM.
OLLAMA_NUM_CTX=16384
# Longest wait for the NEXT token (covers prompt processing), not the whole run.
OLLAMA_TIMEOUT_SECONDS=1200
# Keep the model loaded between requests so it is not reloaded from disk.
OLLAMA_KEEP_ALIVE=30m

# --- Decoding ----------------------------------------------------------
# 0 + fixed seed = repeatable output for the same transcript.
LLM_TEMPERATURE=0
LLM_SEED=42
# Cap per model call; stops runaway generations on slow hardware.
LLM_MAX_OUTPUT_TOKENS=2048

# --- Input -------------------------------------------------------------
# Transcripts above this many (estimated) tokens are split into chunks.
CHUNK_MAX_TOKENS=8000
MAX_TRANSCRIPT_CHARS=300000

# --- Server ------------------------------------------------------------
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
# Comma-separated; only needed if the UI is served from another origin.
CORS_ALLOW_ORIGINS=
ENABLE_DEV_ENDPOINTS=false
